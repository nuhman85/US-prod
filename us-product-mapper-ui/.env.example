DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_SSL=false
PORT=4005

# Optional semantic title matcher. The mapper falls back safely when unavailable.
SEMANTIC_MATCHER_URL=http://127.0.0.1:4010
SEMANTIC_MATCHER_ENABLED=true

# Shared with CompareAllStores. Required for exporting us_product_list rows.
US_PRODUCT_EXPORT_SECRET=
COMPAREALLSTORES_EXPORT_URL=https://compareallstores.com/api/admin/import/us-product-list
COMPAREALLSTORES_TARGET_URL=https://compareallstores.com/us
